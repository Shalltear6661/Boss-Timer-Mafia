# Google Sheets baca (API Key)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEETS_ID=1WL21q_xEAqmt6TQ15zvobC-Ui5vEUxvjMIKDf_1o3Q8
GOOGLE_SHEETS_NAME=BOSS Timer

# --- Tulis sheet: Service Account (disarankan, tanpa npm run auth:google) ---
# 1. Google Cloud → IAM → Service Accounts → Create
# 2. Keys → Add key → JSON → download
# 3. Share spreadsheet ke client_email di JSON sebagai Editor
# 4. Isi salah satu cara di bawah:

GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-sa@project.iam.gserviceaccount.com
# Private key dari JSON (ganti newline asli jadi \n dalam satu baris):
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ATAU tempel seluruh isi file JSON dalam satu baris:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}

# --- Login Google di browser (Editor / view-only) ---
# OAuth Client tipe Web application
# Authorized JavaScript origins: http://localhost:5173 dan https://your-app.vercel.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Email yang boleh Tandai Mati (pisahkan koma)
EDITOR_EMAILS=anda@gmail.com

# Secret cookie session
SESSION_SECRET=ganti-dengan-string-acak

# --- Web Push (notifikasi saat browser minimize / closed) ---
# Generate: yarn generate:vapid   atau   node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com
# Secret untuk /api/cron-push (Vercel Cron atau cron eksternal)
CRON_SECRET=ganti-dengan-string-acak

# Legacy opsional (tidak perlu jika pakai Service Account):
# GOOGLE_OAUTH_REFRESH_TOKEN=
