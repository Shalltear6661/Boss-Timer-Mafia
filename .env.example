# Google Sheets baca (API Key)
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEETS_ID=1WL21q_xEAqmt6TQ15zvobC-Ui5vEUxvjMIKDf_1o3Q8
GOOGLE_SHEETS_NAME=BOSS Timer

# OAuth Web Client (untuk Login Google di browser)
# Buat OAuth Client tipe "Web application"
# Authorized JavaScript origins: http://localhost:5173 dan https://your-app.vercel.app
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Refresh token pemilik sheet — untuk menulis Time of Death (npm run auth:google)
GOOGLE_OAUTH_REFRESH_TOKEN=

# Email yang boleh Tandai Mati (pisahkan koma). Lainnya view-only setelah login.
EDITOR_EMAILS=anda@gmail.com

# Opsional: secret untuk tanda tangan cookie session
SESSION_SECRET=ganti-dengan-string-acak
